# Demo Mode works without credentials. Copy to .env only if needed.
OMOIDE_DATA_DIR=data
OMOIDE_API_KEY=
OMOIDE_MODEL=gpt-4o-mini
# Optional Google Gemini credentials and model (select the provider in the app).
GEMINI_API_KEY=
OMOIDE_GEMINI_MODEL=gemini-3.8-flash
# Cloud processing still requires an explicit opt-in in the app.
